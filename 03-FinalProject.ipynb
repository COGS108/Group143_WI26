        "def build_rq3_subset(df, city, los_col, outcome_col, adopt_label,\n",
        "                     species_col=None, species_val=None):\n",
        "    \"\"\"Filter to dogs, extract length of stay in days, classify adoption as 1/0,\n",
        "    and remove invalid LOS values (negative or > 365 days).\"\"\"\n",
        "    sub = df.copy()\n",
        "    if species_col:\n",
        "        sub = sub[sub[species_col].str.strip().str.upper() == species_val.upper()]\n",
        "    out = pd.DataFrame({\n",
        "        \"city\": city,\n",
        "        \"length_of_stay_days\": pd.to_numeric(sub[los_col], errors=\"coerce\"),\n",
        "        \"adopted\": (sub[outcome_col].str.strip().str.upper() == adopt_label.upper()).astype(int)\n",
        "    })\n",
        "    # keep only rows with valid LOS between 0 and 365 days\n",
        "    return out[(out[\"length_of_stay_days\"].notna()) &\n",
        "               (out[\"length_of_stay_days\"] >= 0) &\n",
        "               (out[\"length_of_stay_days\"] <= 365)]\n",
        "\n",
        "# combine LOS into one dataframe\n",
        "rq3 = pd.concat([\n",
        "    build_rq3_subset(austin, \"Austin\", \"length_of_stay_days\", \"outcome_type\", \"Adoption\", \"animal_type\", \"Dog\"),\n",
        "    build_rq3_subset(louisville, \"Louisville\", \"length_of_stay_days\", \"outtype\", \"ADOPTION\", \"animaltype\", \"DOG\"),\n",
        "    build_rq3_subset(sonoma, \"Sonoma\", \"Days in Shelter\", \"Outcome Type\", \"ADOPTION\", \"Type\", \"DOG\"),\n",
        "    build_rq3_subset(bloomington, \"Bloomington\", \"length_of_stay_days\", \"movementtype\", \"Adoption\", \"speciesname\", \"Dog\"),\n",
        "], ignore_index=True)\n",
        "\n",
        "# create a human-readable label for plotting\n",
        "rq3[\"outcome_label\"] = rq3[\"adopted\"].map({1: \"Adopted\", 0: \"Not Adopted\"})\n",
        "\n",
        "# visualization for RQ3\n",
        "CAP_DAYS = 120\n",
        "PALETTE  = {\"Adopted\": \"#5B9BD5\", \"Not Adopted\": \"#ED7D31\"}\n",
        "fig, axes = plt.subplots(2, 2, figsize=(12, 9), sharey=False)\n",
        "fig.suptitle(\"Length of Stay by Adoption Outcome — Dogs Only\\n(capped at 120 days for readability)\",\n",
        "             fontsize=14, fontweight=\"bold\", y=1.01)\n",
        "\n",
        "for ax, city in zip(axes.flat, CITY_ORDER_4):\n",
        "    sub = rq3[(rq3[\"city\"] == city) & (rq3[\"length_of_stay_days\"] <= CAP_DAYS)]\n",
        "\n",
        "    med_a = sub[sub[\"adopted\"]==1][\"length_of_stay_days\"].median()\n",
        "    med_n = sub[sub[\"adopted\"]==0][\"length_of_stay_days\"].median()\n",
        "    n_a   = (sub[\"adopted\"]==1).sum()\n",
        "    n_n   = (sub[\"adopted\"]==0).sum()\n",
        "\n",
        "    sns.boxplot(data=sub, x=\"outcome_label\", y=\"length_of_stay_days\", hue=\"outcome_label\",\n",
        "                order=[\"Adopted\",\"Not Adopted\"], palette=PALETTE, width=0.45, legend=False, ax=ax,\n",
        "                flierprops=dict(marker=\"o\", markersize=2, alpha=0.25))\n",
        "\n",
        "    for i, (med, label) in enumerate([(med_a,\"Adopted\"), (med_n,\"Not Adopted\")]):\n",
        "        ax.text(i, med + 1.5, f\"med={med:.0f}d\", ha=\"center\", va=\"bottom\", fontsize=8.5, fontweight=\"bold\")\n",
        "\n",
        "    ax.set_title(city, fontsize=12, fontweight=\"bold\")\n",
        "    ax.set_xlabel(\"\")\n",
        "    ax.set_ylabel(\"Days in Shelter\", fontsize=10)\n",
        "    ax.set_xticklabels([f\"Adopted\\n(n={n_a:,})\", f\"Not Adopted\\n(n={n_n:,})\"], fontsize=9)\n",
        "    sns.despine(ax=ax)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"results/rq3_los_boxplots.png\", dpi=150, bbox_inches=\"tight\")\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nMedian Length of Stay (days) by City and Outcome:\")\n",
        "print(rq3.groupby([\"city\",\"outcome_label\"])[\"length_of_stay_days\"].median().unstack().round(1))\n",
        "\n",
        "# Mann-Whitney U tests (non-parametric)\n",
        "# We use Mann-Whitney instead of a t-test because LOS is heavily right-skewed\n",
        "# (most dogs leave quickly, but some stay for months)\n",
        "print(\"\\nMann-Whitney U Tests: LOS — Adopted vs. Not Adopted (two-sided)\")\n",
        "print(\"=\" * 65)\n",
        "for city in CITY_ORDER_4:\n",
        "    a_los = rq3[(rq3[\"city\"]==city) & (rq3[\"adopted\"]==1)][\"length_of_stay_days\"]\n",
        "    n_los = rq3[(rq3[\"city\"]==city) & (rq3[\"adopted\"]==0)][\"length_of_stay_days\"]\n",
        "    u_stat, p = stats.mannwhitneyu(a_los, n_los, alternative=\"two-sided\")\n",
        "    print(f\"\\n{city}:  Adopted median = {a_los.median():.1f}d (n={len(a_los):,}),  \"\n",
        "          f\"Not Adopted median = {n_los.median():.1f}d (n={len(n_los):,})\")\n",
        "    print(f\"  U = {u_stat:.0f},  p = {p:.2e}\")\n",
        "    print(f\"  → {'Significant' if p < 0.05 else 'Not significant'} (p {'<' if p < 0.05 else '>='} 0.05)\")"
